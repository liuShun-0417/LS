(async () => {
    const $ = s => document.querySelector(s);
    const {api, can} = DemoAccess;
    $('#logout-button').onclick = async () => { try { await api('/api/auth/logout',{method:'POST'}); } finally { DemoAuth.clear(); location.replace('/login.html'); } };
    if (!await DemoAccess.ready) return;
    const page = document.body.dataset.page;
    const kind = {users:'user', roles:'role', menus:'menu'}[page];
    let items = [], allMenus = [], pageNumber = 1, totalPages = 1, pending = false, submitEditor, deletion;
    let requestVersion = 0, toastTimer;
    const collapsed = new Set();
    const el = (tag, text, cls) => { const n=document.createElement(tag); n.textContent=text ?? ''; if(cls)n.className=cls; return n; };
    const notify = message => { clearTimeout(toastTimer); $('#toast').textContent=message; $('#toast').hidden=false; toastTimer=setTimeout(()=>$('#toast').hidden=true,4000); };
    const headers = page==='users' ? ['用户','登录账号','角色','用户 ID','操作'] : page==='roles' ? ['角色名称','角色编码','状态','用户数','操作'] : ['菜单名称','类型','页面地址 / 权限标识','排序','状态','操作'];
    const heading=el('tr'); headers.forEach(h=>heading.append(el('th',h))); $('#table-head').append(heading);
    $('#add-record').hidden=!can(`${kind}:create`);
    $('#add-record').onclick=()=>edit().catch(e=>notify(e.message));
    const typeNames={DIRECTORY:'目录', MENU:'页面', BUTTON:'按钮'};
    const badge=(text,on)=>el('span',text,`badge ${on===undefined?'':on?'on':'off'}`);
    const cell=(text)=>el('td',text);
    function action(container,label,permission,fn,danger=false) {
        if(!can(permission)) return;
        const button=el('button',label,`text-button ${danger?'danger':''}`); button.type='button';
        button.onclick=()=>Promise.resolve().then(fn).catch(e=>notify(e.message)); container.append(button);
    }
    function renderRow(item,depth=0) {
        const row=el('tr');
        const identity=cell('');
        const name=el('span',item.name || '未设置姓名','user-name');
        if(page==='menus') {
            identity.style.paddingLeft=`${20+depth*22}px`;
            const children=items.some(m=>m.parentId===item.id);
            const toggle=el('button',children?(collapsed.has(item.id)?'▸':'▾'):'·','tree-toggle'); toggle.type='button'; toggle.disabled=!children;
            toggle.setAttribute('aria-label',`${collapsed.has(item.id)?'展开':'折叠'}${item.name}`);
            if(children) toggle.setAttribute('aria-expanded',String(!collapsed.has(item.id)));
            toggle.onclick=()=>{ collapsed.has(item.id)?collapsed.delete(item.id):collapsed.add(item.id); renderMenus(); };
            identity.append(toggle);
        }
        identity.append(name);
        if(item.builtin)identity.append(el('span','系统内置','small'));
        if(page==='roles' && item.description)identity.append(el('span',item.description,'small'));
        row.append(identity);
        if(page==='users') {
            row.append(cell(item.account)); const role=cell(''); role.append(badge(item.roleName || '未绑定')); row.append(role,cell(item.id));
        } else if(page==='roles') {
            row.append(cell(item.code)); const status=cell(''); status.append(badge(item.enabled?'启用':'停用',item.enabled)); row.append(status,cell(item.userCount));
        } else {
            const type=cell(''); type.append(badge(typeNames[item.type]));
            const path=cell(item.path || '—'); if(item.permission)path.append(el('span',item.permission,'small'));
            const status=cell(''); status.append(badge(item.enabled?'启用':'停用',item.enabled));
            row.append(type,path,cell(item.sortOrder),status);
        }
        const actions=el('div','','row-actions');
        action(actions,'编辑',`${kind}:update`,()=>edit(item));
        if(page==='users')action(actions,'绑定角色','user:assign-role',()=>bind(item));
        if(page==='roles')action(actions,item.code==='super_admin'?'查看权限':'分配权限','role:grant',()=>grant(item));
        if(!item.builtin) action(actions,'删除',`${kind}:delete`,()=>askDelete(item),true);
        const td=cell(''); td.append(actions.childElementCount?actions:el('span','—','muted')); row.append(td);
        return row;
    }
    function renderMenus() {
        const keyword=$('#search').value.trim().toLowerCase();
        const visible=new Set();
        for(const item of items) if(!keyword || `${item.name} ${item.permission||''} ${item.path||''}`.toLowerCase().includes(keyword)) {
            let current=item;
            while(current && !visible.has(current.id)) { visible.add(current.id); current=items.find(m=>m.id===current.parentId); }
        }
        const rows=[];
        const append=(parent,depth)=>items.filter(m=>m.parentId===parent && visible.has(m.id)).forEach(m=>{
            rows.push(renderRow(m,depth)); if(keyword || !collapsed.has(m.id))append(m.id,depth+1);
        });
        append(null,0); $('#rows').replaceChildren(...rows);
        $('#page-summary').textContent=`共 ${items.length} 项，当前显示 ${rows.length} 项`;
        if(!rows.length) showState('没有匹配的菜单','请调整搜索条件，或新增菜单。',false);
    }
    function showState(title,description,retry) {
        $('#list-state').hidden=false; $('#table-area').hidden=true;
        $('#state-title').textContent=title; $('#state-description').textContent=description; $('#retry').hidden=!retry;
    }
    async function load() {
        const version=++requestVersion;
        showState('正在加载','正在获取最新数据，请稍候。',false);
        try {
            const keyword=$('#search').value.trim();
            const data=await api(`/api/${page}`+(page==='users'?`?page=${pageNumber}&keyword=${encodeURIComponent(keyword)}`:''));
            if(version!==requestVersion)return;
            items=page==='users'?data.items:data;
            if(page==='users' && data.total>0 && pageNumber>data.totalPages) { pageNumber=data.totalPages; return load(); }
            $('#record-count').textContent=page==='users'?data.total:items.length;
            $('#list-caption').textContent=page==='users'?'每位用户仅绑定一个角色，每页 20 条':page==='roles'?'角色停用后，其用户保留登录能力，但无法访问业务功能':'目录 → 页面 → 按钮权限；内置菜单可调整名称与排序';
            $('#list-state').hidden=true; $('#table-area').hidden=false;
            $('#page-controls').hidden=page!=='users';
            if(page==='menus') { allMenus=items; renderMenus(); }
            else {
                const visible=page==='roles'?items.filter(r=>`${r.name} ${r.code}`.toLowerCase().includes(keyword.toLowerCase())):items;
                $('#rows').replaceChildren(...visible.map(item=>renderRow(item)));
                $('#page-summary').textContent=page==='users'?`共 ${data.total} 位用户`:`共 ${items.length} 个角色，匹配 ${visible.length} 个`;
                if(!visible.length)showState('没有匹配的数据','请调整搜索条件，或点击新增。',false);
            }
            if(page==='users') {
                totalPages=data.totalPages; $('#page-indicator').textContent=`${pageNumber} / ${Math.max(totalPages,1)} 页`;
                $('#previous-page').disabled=pageNumber<=1; $('#next-page').disabled=pageNumber>=totalPages;
            }
        } catch(e) { if(version===requestVersion)showState('加载失败',e.message,true); }
    }
    function field(name,label,value='',options={}) {
        const id=`field-${name}`; const labelNode=el('label',label); labelNode.htmlFor=id;
        const input=document.createElement(options.choices?'select':options.multiline?'textarea':'input'); input.id=id; input.name=name;
        if(options.choices) options.choices.forEach(([v,t])=>{ const option=el('option',t); option.value=v; input.append(option); });
        else { input.type=options.type||'text'; input.maxLength=options.max||100; }
        input.value=value??''; input.required=!!options.required; input.disabled=!!options.disabled;
        if(options.type==='password')input.autocomplete='new-password';
        if(options.type==='number') { input.min='0'; input.max='9999'; }
        $('#fields').append(labelNode,input);
        return input;
    }
    const value=name=>$(`#field-${name}`).value;
    function openEditor(title,description) {
        $('#editor-form').reset(); $('#fields').replaceChildren(); $('#form-error').hidden=true;
        $('#editor-title').textContent=title; $('#editor-description').textContent=description;
        $('#save').hidden=false; $('#save').textContent='保存';
    }
    function showEditor() { $('#editor').showModal(); $('#fields input:not(:disabled),#fields select:not(:disabled)')?.focus(); }
    async function roleField(selected) {
        const roles=await api('/api/roles/options');
        const choices=roles.map(r=>[r.id,`${r.name}（${r.code}）`]);
        if(selected && !roles.some(r=>r.id===selected))choices.unshift([selected,'当前角色已停用，请更换']);
        return field('roleId','绑定角色（单选）',selected??roles.find(r=>r.code==='member')?.id,{required:true,choices});
    }
    async function edit(item=null) {
        openEditor(`${item?'编辑':'新增'}${{users:'用户',roles:'角色',menus:'菜单'}[page]}`,page==='users'?'新用户默认绑定普通用户角色；编辑时密码留空表示不修改。':page==='roles'?'按职责分配权限；角色编码用于识别角色。':'页面地址仅支持本站路径。自定义权限需由对应后端接口校验。');
        if(page==='users') {
            field('name','用户姓名',item?.name); field('account','登录账号 *',item?.account,{required:true});
            field('passwd',item?'登录密码（留空不修改）':'登录密码 *','',{type:'password',required:!item});
            if(can('user:assign-role'))await roleField(item?.roleId);
        } else if(page==='roles') {
            field('name','角色名称 *',item?.name,{required:true}); field('code','角色编码 *',item?.code,{required:true,max:64,disabled:item?.builtin});
            field('description','角色说明',item?.description,{multiline:true,max:255});
            field('enabled','状态',item?.enabled===false?'false':'true',{choices:[['true','启用'],['false','停用']],disabled:item?.builtin});
        } else {
            const descendants=new Set(item?[item.id]:[]);
            let changed=true; while(changed) { changed=false; for(const m of allMenus)if(descendants.has(m.parentId)&&!descendants.has(m.id)){descendants.add(m.id);changed=true;} }
            field('name','菜单名称 *',item?.name,{required:true});
            const type=field('type','菜单类型',item?.type||'MENU',{choices:Object.entries(typeNames),disabled:item?.builtin});
            const parent=field('parentId','上级菜单',item?.parentId||'',{choices:[['','顶级菜单'],...allMenus.filter(m=>m.type!=='BUTTON'&&!descendants.has(m.id)).map(m=>[m.id,`${typeNames[m.type]} · ${m.name}`])],disabled:item?.builtin});
            const path=field('path','页面地址',item?.path,{max:200,disabled:item?.builtin});
            const permission=field('permission','权限标识',item?.permission,{disabled:item?.builtin});
            field('sortOrder','排序（越小越靠前）',item?.sortOrder??0,{type:'number',required:true});
            field('enabled','状态',item?.enabled===false?'false':'true',{choices:[['true','启用'],['false','停用']],disabled:item?.builtin});
            const sync=()=>{ path.required=type.value==='MENU'; permission.required=type.value!=='DIRECTORY'; parent.required=type.value==='BUTTON';
                if(!item?.builtin){path.disabled=type.value!=='MENU';permission.disabled=type.value==='DIRECTORY';} };
            type.onchange=sync; sync();
        }
        submitEditor=async()=>{
            let body;
            if(page==='users') {
                body={name:value('name').trim()||null,account:value('account').trim()};
                if(value('passwd'))body.passwd=value('passwd');
                if($('#field-roleId'))body.roleId=Number(value('roleId'));
            } else if(page==='roles')body={name:value('name').trim(),code:value('code').trim(),description:value('description').trim(),enabled:value('enabled')==='true'};
            else body={name:value('name').trim(),type:value('type'),parentId:value('parentId')?Number(value('parentId')):null,
                path:value('type')==='MENU'?value('path').trim():null,permission:value('type')!=='DIRECTORY'?value('permission').trim():null,
                sortOrder:Number(value('sortOrder')),enabled:value('enabled')==='true'};
            if(!body.name && page!=='users')throw new Error('名称不能为空');
            if(page==='users' && (!body.account || (!item && !body.passwd?.trim()) || (body.passwd && !body.passwd.trim())))throw new Error('账号和密码不能只包含空格');
            await api(`/api/${page}${item?'/'+item.id:''}`,{method:item?'PUT':'POST',body:JSON.stringify(body)});
        };
        showEditor();
    }
    async function bind(user) {
        openEditor('绑定角色',`为用户「${user.name||user.account}」选择一个角色；保存后替换原角色。`);
        await roleField(user.roleId);
        submitEditor=()=>api(`/api/users/${user.id}/role`,{method:'PUT',body:JSON.stringify({roleId:Number(value('roleId'))})});
        showEditor();
    }
    async function grant(role) {
        const [menus,grants]=await Promise.all([api('/api/menus/permission-tree'),api(`/api/roles/${role.id}/permissions`)]);
        openEditor(`${role.code==='super_admin'?'查看':'分配'}权限 · ${role.name}`,role.code==='super_admin'?'超级管理员始终拥有全部权限，无需单独分配。':'勾选目录可选中下级功能；勾选按钮会自动补全所属页面。');
        const readonly=role.code==='super_admin'; const selected=new Set(grants), inputs=new Map();
        const tree=el('div','','permission-tree'); tree.setAttribute('aria-label','角色权限');
        const children=id=>menus.filter(m=>m.parentId===id);
        const setBranch=(id,checked)=>{ checked?selected.add(id):selected.delete(id); children(id).forEach(m=>setBranch(m.id,checked)); };
        const update=()=>{
            for(const [id,input] of inputs){ input.checked=selected.has(id); const below=[]; const walk=p=>children(p).forEach(m=>{below.push(m.id);walk(m.id);}); walk(id);
                input.indeterminate=below.some(v=>selected.has(v)) && !below.every(v=>selected.has(v)); }
        };
        const append=(parent,depth)=>children(parent).forEach(menu=>{
            const label=el('label'); label.style.paddingLeft=`${depth*20}px`;
            const input=el('input'); input.type='checkbox'; input.value=menu.id; input.disabled=readonly; inputs.set(menu.id,input);
            input.onchange=()=>{ setBranch(menu.id,input.checked); if(input.checked){let current=menu;while(current.parentId){selected.add(current.parentId);current=menus.find(m=>m.id===current.parentId);}} update(); };
            label.append(input,el('span',menu.name),el('span',menu.permission||typeNames[menu.type],'permission-code'));
            if(!menu.enabled)label.append(badge('已停用',false)); tree.append(label); append(menu.id,depth+1);
        });
        const tools=el('div','','toolbar');
        if(!readonly)for(const [label,checked] of [['全选',true],['清空',false]]){const button=el('button',label,'button button-subtle');button.type='button';button.onclick=()=>{menus.forEach(m=>checked?selected.add(m.id):selected.delete(m.id));update();};tools.append(button);}
        $('#fields').append(tools,tree); append(null,0); update(); $('#save').hidden=readonly;
        submitEditor=()=>api(`/api/roles/${role.id}/permissions`,{method:'PUT',body:JSON.stringify({menuIds:[...selected]})});
        showEditor();
    }
    function askDelete(item) {
        deletion=item; $('#confirm-description').textContent=`确定删除「${item.name||item.account}」？此操作不可撤销。${page==='roles'?'已绑定用户的角色不能删除。':page==='menus'?'关联的角色授权将同时移除。':''}`;
        $('#confirm-error').hidden=true; $('#confirm').showModal(); $('#confirm [data-close]').focus();
    }
    async function submit(event,dialog,errorSelector,work) {
        event.preventDefault(); if(pending)return; pending=true;
        const buttons=[...dialog.querySelectorAll('button')]; buttons.forEach(b=>b.disabled=true); $(errorSelector).hidden=true;
        try { await work(); dialog.close(); notify('操作成功'); await load(); }
        catch(e) { $(errorSelector).textContent=e.message; $(errorSelector).hidden=false; }
        finally { pending=false; buttons.forEach(b=>b.disabled=false); }
    }
    $('#editor-form').onsubmit=e=>submit(e,$('#editor'),'#form-error',()=>submitEditor());
    $('#confirm-form').onsubmit=e=>submit(e,$('#confirm'),'#confirm-error',()=>api(`/api/${page}/${deletion.id}`,{method:'DELETE'}));
    document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>{if(!pending)$(`#${b.dataset.close}`).close();});
    document.querySelectorAll('dialog').forEach(d=>d.addEventListener('cancel',e=>{if(pending)e.preventDefault();}));
    $('#refresh').onclick=load; $('#retry').onclick=load;
    $('#search-form').onsubmit=e=>{e.preventDefault();pageNumber=1;load();};
    $('#previous-page').onclick=()=>{if(pageNumber>1){pageNumber--;load();}};
    $('#next-page').onclick=()=>{if(pageNumber<totalPages){pageNumber++;load();}};
    api('/api/auth/me').then(user=>$('#current-account').textContent=`${user.name||user.account} · ${user.roleName||''}`).catch(e=>notify(e.message));
    await load();
})();
